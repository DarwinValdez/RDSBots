# ---------- Supabase ----------
# Public (safe for the browser; access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used by cron jobs and admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Data providers (server only) ----------
# API-Sports key (covers API-Football, NBA, Baseball, American Football, Hockey)
API_SPORTS_KEY=
# The Odds API key
ODDS_API_KEY=

# ---------- AI (server only) ----------
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
CLAUDE_MODEL=

# ---------- Jobs ----------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
